<launch>
  <machine name="localhost" address="localhost" />

  <arg name="manager" default="femto_mega_rgb_decompress_nodelet_manager" />
  <arg name="launch_manager" default="true" />
  <arg name="machine" default="localhost" />

  <arg name="gui" default="false" />

  <arg name="RGB_CAMERA_INFO" default="/femto_mega/color/camera_info" />
  <arg name="RGB_IMAGE" default="/femto_mega/color/image_raw" />
  <arg name="RGB_REMOTE_IMAGE" default="/femto_mega_remote/color/image_raw" />
  <!-- <arg name="DEPTH_CAMERA_INFO" default="/femto_mega/depth/camera_info" /> -->
  <!-- <arg name="DEPTH_IMAGE" default="/femto_mega/depth/image_raw" /> -->
  <!-- <arg name="DEPTH_REMOTE_IMAGE" default="/femto_mega_remote/depth/image_raw" /> -->
  <!-- <arg name="CLOUD" default="/femto_mega_remote/depth_registered/points" /> -->

  <node name="$(arg manager)" pkg="nodelet" type="nodelet" args="manager"
        machine="$(arg machine)" if="$(arg launch_manager)"
        output="screen" />

  <node name="femto_mega_rgb_decompress" pkg="image_transport" type="republish"
        args="compressed in:=$(arg RGB_IMAGE) out:=$(arg RGB_REMOTE_IMAGE)" />
  <!-- <node name="femto_mega_depth_decompress" pkg="image_transport" type="republish" -->
  <!--       args="compressedDepth in:=$(arg DEPTH_IMAGE) out:=$(arg DEPTH_REMOTE_IMAGE)" /> -->
  <!-- <node pkg="nodelet" type="nodelet" name="femto_mega_point_cloud_xyzrgb" -->
  <!--       args="load depth_image_proc/point_cloud_xyzrgb $(arg manager)" output="screen" > -->
  <!--   <remap from="rgb/camera_info" to="$(arg RGB_CAMERA_INFO)" /> -->
  <!--   <remap from="rgb/image_rect_color" to="$(arg RGB_REMOTE_IMAGE)" /> -->
  <!--   <remap from="depth_registered/image_rect" to="$(arg DEPTH_REMOTE_IMAGE)" /> -->
  <!--   <remap from="depth_registered/points" to="$(arg CLOUD)" /> -->
  <!--   <rosparam> -->
  <!--     queue_size: 100 -->
  <!--   </rosparam> -->
  <!-- </node> -->

  <!-- rviz -->
  <group if="$(arg gui)">
    <node name="femto_mega_rgb_decomp_rviz"
          pkg="rviz" type="rviz"
          args="-d $(find jsk_2023_09_cook_from_recipe)/rviz/femto_mega_pointcloud_decomp.rviz">
    </node>
  </group>
</launch>
