<launch>
  <arg name="gui" default="true" />

  <arg name="input_image" default="/femto_mega_remote/color/image_raw"/>
  <!-- <arg name="input_image" default="/femto_mega/color/image_raw"/> -->
  <arg name="input_camera_info" default="/femto_mega/color/camera_info"/>

  <!-- <arg name="input_image" default="/kinect_head/rgb/image_rect_color"/> -->
  <!-- <arg name="input_camera_info" default="/kinect_head/rgb/camera_info"/> -->

  <arg name="manager" default="kitchen_template_manager"/>

  <node name="$(arg manager)"
        pkg="nodelet" type="nodelet"
        args="manager" output="screen"/>

  <group ns="point_pose_stove">
    <node name="stove_sift" pkg="imagesift" type="imagesift"
          launch-prefix="nice -n +10" output="screen">
      <remap from="image" to="$(arg input_image)" />
      <remap from="camera_info" to="$(arg input_camera_info)"/>
    </node>
    <!-- <node name="stove_detector" pkg="jsk_perception" type="point_pose_extractor" clear_params="true"> -->
    <!--   <rosparam subst_value="true"> -->
    <!--     template_filename: $(find jsk_2023_09_cook_from_recipe)/image/femto_mega_stove_v2.jpg -->
    <!--     window_name: stove_detector -->
    <!--     object_width: 0.297 -->
    <!--     object_height: 0.210 -->
    <!--   </rosparam> -->
    <!-- </node> -->
    <node name="stove_detector" pkg="jsk_perception" type="point_pose_extractor" clear_params="true">
      <rosparam subst_value="true">
        template_filename: $(find jsk_2023_09_cook_from_recipe)/image/ric137_kankisen_x-5.jpg
        window_name: stove_detector
        object_width: 0.297
        object_height: 0.210
      </rosparam>
    </node>
  </group>

  <group ns="point_pose_kitchen">
    <node name="kitchen_sift" pkg="imagesift" type="imagesift"
          launch-prefix="nice -n +10" output="screen">
      <remap from="image" to="$(arg input_image)" />
      <remap from="camera_info" to="$(arg input_camera_info)"/>
    </node>
    <node name="kitchen_detector" pkg="jsk_perception" type="point_pose_extractor" clear_params="true">
      <rosparam subst_value="true">
        template_filename: $(find jsk_2023_09_cook_from_recipe)/image/pr2-kitchen-k4a.jpg
        window_name: kitchen_detector
        object_width: 0.297
        object_height: 0.210
      </rosparam>
    </node>
  </group>

  <group ns="point_pose_sink">
    <node name="sink_sift" pkg="imagesift" type="imagesift"
          launch-prefix="nice -n +10" output="screen">
      <remap from="image" to="$(arg input_image)" />
      <remap from="camera_info" to="$(arg input_camera_info)"/>
    </node>
    <node name="sink_detector" pkg="jsk_perception" type="point_pose_extractor">
      <rosparam subst_value="true">
        template_filename: $(find jsk_2023_09_cook_from_recipe)/image/pr2-sink-k4a.jpg
        window_name: sink_detector
        object_width: 0.297
        object_height: 0.210
      </rosparam>
    </node>
  </group>

  <group ns="point_pose_ih">
    <node name="ih_sift" pkg="imagesift" type="imagesift"
          launch-prefix="nice -n +10" output="screen">
      <remap from="image" to="$(arg input_image)" />
      <remap from="camera_info" to="$(arg input_camera_info)"/>
    </node>
    <node name="ih_detector" pkg="jsk_perception" type="point_pose_extractor" clear_params="true">
      <rosparam subst_value="true">
        template_filename: $(find jsk_2023_09_cook_from_recipe)/image/femto_mega_ih_panel_panel.jpg
        window_name: ih_detector
        object_width: 0.28
        object_height: 0.142
      </rosparam>
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/femto_mega_ih_panel.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.13 -->
      <!--   object_height: 0.12 -->
      <!-- </rosparam> -->
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/femto_mega_ih_panel_mark.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.16 -->
      <!--   object_height: 0.05 -->
      <!-- </rosparam> -->

      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/k4a-ih-panel-cropped.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.277 -->
      <!--   object_height: 0.144 -->
      <!-- </rosparam> -->
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/k4a-ih-panel-2-cropped.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.277 -->
      <!--   object_height: 0.144 -->
      <!-- </rosparam> -->
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/k4a-ih-panel-iphone0-cropped.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.277 -->
      <!--   object_height: 0.144 -->
      <!-- </rosparam> -->
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/k4a-ih-panel-iphone-cropped.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.227 -->
      <!--   object_height: 0.144 -->
      <!-- </rosparam> -->
    </node>
  </group>

</launch>
