<launch>
  <arg name="gui" default="true" />

  <arg name="input_image" default="/r_hand_d405/color/image_rect_color"/>
  <arg name="input_camera_info" default="/r_hand_d405/color/camera_info"/>

  <arg name="manager" default="kitchen_template_manager_rd405"/>

  <node name="$(arg manager)"
        pkg="nodelet" type="nodelet"
        args="manager" output="screen"/>

  <group ns="point_pose_ih_rd405">
    <node name="ih_sift" pkg="imagesift" type="imagesift"
          launch-prefix="nice -n +10" output="screen">
      <remap from="image" to="$(arg input_image)" />
      <remap from="camera_info" to="$(arg input_camera_info)"/>
    </node>

    <node name="ih_detector" pkg="jsk_perception" type="point_pose_extractor" clear_params="true">
      <rosparam subst_value="true">
        template_filename: $(find jsk_2023_09_cook_from_recipe)/image/20250513_ih_rhand_cam.jpg
        window_name: ih_detector
        object_width: 0.225
        object_height: 0.145
      </rosparam>
      <!-- <rosparam subst_value="true"> -->
      <!--   template_filename: $(find jsk_2023_09_cook_from_recipe)/image/r_hand_d405_ih_panel.jpg -->
      <!--   window_name: ih_detector -->
      <!--   object_width: 0.277 -->
      <!--   object_height: 0.144 -->
      <!-- </rosparam> -->
    </node>


  </group>

</launch>
