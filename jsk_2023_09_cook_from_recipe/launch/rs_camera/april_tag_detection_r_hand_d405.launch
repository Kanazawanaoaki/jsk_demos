<launch>
  <!-- You need to run this launch file in the PR2 robot for higher frequency of the image,
  otherwise the internal message filter will not work -->
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="r_hand_d405_apriltag_pose_detector">
    <remap from="image_rect" to="/r_hand_d405/color/image_rect_color" />
    <remap from="camera_info" to="/r_hand_d405/color/camera_info" />
    <rosparam>
      <!-- NOTE: the size is the inner square's edge length of the tag, not the outer edge length!!! -->
      standalone_tags: [{id: 1, size: 0.057, name: apriltag_r_hand},]
      tag_family: "tagStandard41h12"
      publish_tf: true
    </rosparam>
  </node>
</launch>
