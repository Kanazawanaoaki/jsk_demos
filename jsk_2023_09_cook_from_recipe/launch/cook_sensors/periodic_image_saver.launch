<launch>
  <arg name="INPUT_IMAGE" default="/camera_remote/color/image_raw" />

  <!-- ノードの起動 -->
  <node name="periodic_image_saver" pkg="jsk_2023_09_cook_from_recipe" type="periodic_image_saver.py" output="screen"
        clear_params="true">
    <!-- rosparamで保存先ディレクトリを設定 -->
    <param name="save_path" value="$(find jsk_2023_09_cook_from_recipe)/datas/sensor_data_images/" />
    <!-- トピックのリマップ -->
    <param name="input" value="$(arg INPUT_IMAGE)"/>
  </node>
</launch>
